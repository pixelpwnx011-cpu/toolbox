<?xml version="1.0" encoding="utf-8"?>
<!--
  Outer root is a FrameLayout purely so the resize-handle grip can float in
  the bottom-right corner on top of the card. The actual window size comes
  from the WindowManager.LayoutParams set in code (OverlayService), not from
  the width/height below — those are placeholders used only during preview.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calculatorOuterRoot"
    android:layout_width="280dp"
    android:layout_height="420dp">

    <LinearLayout
        android:id="@+id/calculatorRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tool_card"
        android:elevation="14dp"
        android:orientation="vertical">

        <!-- Header / drag bar -->
        <LinearLayout
            android:id="@+id/calculatorHeader"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_tool_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_calculator" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Calculator"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseCalculator"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="Close"
                android:padding="7dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Everything below the header shares the remaining height, so the
             whole card reflows proportionally as it's resized. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Expression / display -->
            <TextView
                android:id="@+id/tvCalcExpression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:ellipsize="start"
                android:gravity="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/geneo_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvCalcResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:ellipsize="start"
                android:gravity="end"
                android:maxLines="1"
                android:text="0"
                android:textColor="@color/geneo_text_primary"
                android:textSize="36sp"
                android:textStyle="bold" />

            <!-- Keypad: fills whatever vertical space is left, rows share it
                 equally so buttons grow/shrink together as the card resizes. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button android:id="@+id/btnClear" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_clear" android:text="C" android:textColor="@color/white"/>
                    <Button android:id="@+id/btnBackspace" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_operator" android:text="⌫" android:textColor="@color/white"/>
                    <Button android:id="@+id/btnPercent" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_operator" android:text="%" android:textColor="@color/white"/>
                    <Button android:id="@+id/btnDivide" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_operator" android:text="÷" android:textColor="@color/white"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button android:id="@+id/btn7" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_digit" android:text="7" android:textColor="@color/geneo_text_primary"/>
                    <Button android:id="@+id/btn8" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_digit" android:text="8" android:textColor="@color/geneo_text_primary"/>
                    <Button android:id="@+id/btn9" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_digit" android:text="9" android:textColor="@color/geneo_text_primary"/>
                    <Button android:id="@+id/btnMultiply" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_operator" android:text="×" android:textColor="@color/white"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button android:id="@+id/btn4" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_digit" android:text="4" android:textColor="@color/geneo_text_primary"/>
                    <Button android:id="@+id/btn5" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_digit" android:text="5" android:textColor="@color/geneo_text_primary"/>
                    <Button android:id="@+id/btn6" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_digit" android:text="6" android:textColor="@color/geneo_text_primary"/>
                    <Button android:id="@+id/btnMinus" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_operator" android:text="−" android:textColor="@color/white"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button android:id="@+id/btn1" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_digit" android:text="1" android:textColor="@color/geneo_text_primary"/>
                    <Button android:id="@+id/btn2" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_digit" android:text="2" android:textColor="@color/geneo_text_primary"/>
                    <Button android:id="@+id/btn3" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_digit" android:text="3" android:textColor="@color/geneo_text_primary"/>
                    <Button android:id="@+id/btnPlus" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_operator" android:text="+" android:textColor="@color/white"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button android:id="@+id/btn0" style="@style/CalcKey" android:layout_weight="2" android:background="@drawable/bg_calc_digit" android:text="0" android:textColor="@color/geneo_text_primary"/>
                    <Button android:id="@+id/btnDot" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_digit" android:text="." android:textColor="@color/geneo_text_primary"/>
                    <Button android:id="@+id/btnEquals" style="@style/CalcKey" android:layout_weight="1" android:background="@drawable/bg_calc_equals" android:text="=" android:textColor="@color/white"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Drag-to-resize handle, bottom-right corner. Touch target is bigger
         than the visible icon for easy grabbing on a touchscreen board. -->
    <FrameLayout
        android:id="@+id/resizeHandle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:elevation="16dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:alpha="0.85"
            android:src="@drawable/ic_resize_handle" />
    </FrameLayout>

</FrameLayout>
