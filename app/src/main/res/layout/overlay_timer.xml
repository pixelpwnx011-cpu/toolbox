<?xml version="1.0" encoding="utf-8"?>
<!--
  Outer root is a FrameLayout so the resize-handle grip can float in the
  bottom-right corner on top of the card. Actual window size comes from the
  WindowManager.LayoutParams set in code (OverlayService), not the
  width/height below (those are placeholders used only during preview).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timerOuterRoot"
    android:layout_width="270dp"
    android:layout_height="340dp">

    <LinearLayout
        android:id="@+id/timerRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tool_card"
        android:elevation="14dp"
        android:orientation="vertical">

        <!-- Header / drag bar -->
        <LinearLayout
            android:id="@+id/timerHeader"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_tool_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_timer" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Timer"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseTimer"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="Close"
                android:padding="7dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Everything below the header shares the remaining height. The timer
             has no naturally-growing list like the stopwatch's laps, so this
             block is vertically centered — resizing taller just gives it more
             breathing room instead of leaving dead space at the bottom. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTimerTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="05:00"
                android:textColor="@color/geneo_text_primary"
                android:textSize="42sp"
                android:textStyle="bold" />

            <!-- Quick adjust (only meaningful while idle) -->
            <LinearLayout
                android:id="@+id/timerAdjustRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMinus1Min"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="-1m"
                    android:textColor="@color/geneo_text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnMinus10Sec"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="-10s"
                    android:textColor="@color/geneo_text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPlus10Sec"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="+10s"
                    android:textColor="@color/geneo_accent"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPlus1Min"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="+1m"
                    android:textColor="@color/geneo_accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnStartPauseTimer"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/bg_round_button_accent"
                    android:contentDescription="Start"
                    android:padding="16dp"
                    android:src="@drawable/ic_play" />

                <ImageButton
                    android:id="@+id/btnResetTimer"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_round_button"
                    android:contentDescription="Reset"
                    android:padding="11dp"
                    android:src="@drawable/ic_reset" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Drag-to-resize handle, bottom-right corner. -->
    <FrameLayout
        android:id="@+id/resizeHandle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:elevation="16dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:alpha="0.85"
            android:src="@drawable/ic_resize_handle" />
    </FrameLayout>

</FrameLayout>
