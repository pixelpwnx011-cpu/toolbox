<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/geneo_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="NCERT Class 10 Library"
            android:textColor="@color/geneo_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="One-time setup: extract your NCERT folder onto this device (USB, SD card, or downloads), then point this at the top-level folder. It auto-detects Science, Math, Social Science (Eco/Geo/His/Pol Sc), English (First Flight/FWF) and Hindi (Kshitij/Kritika) chapters by their existing folder names — nothing is copied, the PDFs stay where they are."
            android:textColor="@color/geneo_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_tool_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvImportStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No folder imported yet"
                android:textColor="@color/geneo_warning"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnImportFolder"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/geneo_primary"
                android:text="Select NCERT Folder" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Current library"
            android:textColor="@color/geneo_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/libraryListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:text="Chapters are opened from the bubble's Books menu on the board once imported here."
            android:textColor="@color/geneo_text_secondary"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
