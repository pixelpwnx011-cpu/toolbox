<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end"
    android:paddingBottom="10dp">

    <!-- Pen -->
    <LinearLayout
        android:id="@+id/itemPen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/labelPen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_tool_card"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Pen"
            android:textColor="@color/geneo_text_primary"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/btnPen"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_menu_option"
            android:elevation="6dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_pen" />
        </FrameLayout>
    </LinearLayout>

    <!-- Books -->
    <LinearLayout
        android:id="@+id/itemBooks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/labelBooks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_tool_card"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Books"
            android:textColor="@color/geneo_text_primary"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/btnBooks"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_menu_option"
            android:elevation="6dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_book" />
        </FrameLayout>
    </LinearLayout>

    <!-- Calculator -->
    <LinearLayout
        android:id="@+id/itemCalculator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/labelCalculator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_tool_card"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Calculator"
            android:textColor="@color/geneo_text_primary"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/btnCalculator"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_menu_option"
            android:elevation="6dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_calculator" />
        </FrameLayout>
    </LinearLayout>

    <!-- Timer -->
    <LinearLayout
        android:id="@+id/itemTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/labelTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_tool_card"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Timer"
            android:textColor="@color/geneo_text_primary"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/btnTimer"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_menu_option"
            android:elevation="6dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_timer" />
        </FrameLayout>
    </LinearLayout>

    <!-- Stopwatch -->
    <LinearLayout
        android:id="@+id/itemStopwatch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/labelStopwatch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_tool_card"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Stopwatch"
            android:textColor="@color/geneo_text_primary"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/btnStopwatch"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_menu_option"
            android:elevation="6dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_stopwatch" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
