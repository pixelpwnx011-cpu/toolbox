<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/geneo_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/bg_bubble" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="22dp"
            android:layout_marginTop="-50dp"
            android:src="@drawable/ic_bubble_grid" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Geneo Toolbox"
            android:textColor="@color/geneo_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="A floating toolbox for your Geneo smart board — Stopwatch, Timer and Calculator, one tap away over any app."
            android:textColor="@color/geneo_text_secondary"
            android:textSize="14sp" />

        <!-- Step 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_tool_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 1 · Display over other apps"
                android:textColor="@color/geneo_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Required so the bubble can float on top of every app on the board."
                android:textColor="@color/geneo_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvOverlayStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Status: Not granted"
                android:textColor="@color/geneo_warning"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnGrantOverlay"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/geneo_primary"
                android:text="@string/grant_overlay" />
        </LinearLayout>

        <!-- Step 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tool_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 2 · Start the floating toolbox"
                android:textColor="@color/geneo_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Once enabled, the bubble stays on screen and restarts automatically every time the board reboots."
                android:textColor="@color/geneo_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvServiceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Status: Stopped"
                android:textColor="@color/geneo_warning"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnToggleService"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/geneo_success"
                android:text="@string/start_service" />
        </LinearLayout>

        <!-- Step 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tool_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 3 · Allow to run in the background"
                android:textColor="@color/geneo_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Exempts Geneo Toolbox from battery optimization so Android doesn't pause or kill the bubble in the background."
                android:textColor="@color/geneo_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvBatteryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Status: Not exempted"
                android:textColor="@color/geneo_warning"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBatteryOptimization"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/geneo_primary"
                android:text="@string/disable_battery_optimization" />
        </LinearLayout>

        <!-- Step 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tool_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 4 (optional) · NCERT Class 10 books"
                android:textColor="@color/geneo_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Import a folder of NCERT chapter PDFs once so the Books option on the bubble can open them."
                android:textColor="@color/geneo_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnManageLibrary"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/geneo_primary"
                android:text="Manage NCERT Library" />
        </LinearLayout>

        <!-- Step 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tool_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 5 (optional) · Word meaning lookup"
                android:textColor="@color/geneo_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Lets you select a word in the PDF viewer and see its meaning. Needs a free OCR.space API key (no Google account, no card — sign up at ocr.space/ocrapi, takes under a minute) and an internet connection."
                android:textColor="@color/geneo_text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etOcrApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autofillHints="password"
                android:background="@drawable/bg_calc_digit"
                android:hint="Paste your OCR.space API key"
                android:inputType="textVisiblePassword"
                android:padding="12dp"
                android:textColor="@color/geneo_text_primary"
                android:textColorHint="@color/geneo_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvOcrKeyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Status: Not set"
                android:textColor="@color/geneo_warning"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSaveOcrKey"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/geneo_primary"
                android:text="Save Key" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Tip: tap the floating bubble once to open the toolbox, tap it again to close it."
            android:textColor="@color/geneo_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Note: some board manufacturers (e.g. Xiaomi/MIUI, Vivo, Oppo, Realme) have an extra &quot;Autostart&quot; or &quot;No restrictions&quot; toggle in their own battery settings, outside standard Android. If the bubble ever fails to reappear after a reboot, check that setting for Geneo Toolbox too."
            android:textColor="@color/geneo_text_secondary"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
